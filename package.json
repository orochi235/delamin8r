{
  "name": "reticul8r",
  "version": "0.1.0",
  "description": "Turn a DOM subtree into a parallax window: the elements already in it become depth planes.",
  "type": "module",
  "license": "MIT",
  "files": ["dist", "README.md"],
  "main": "./dist/reticul8r.js",
  "module": "./dist/reticul8r.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/reticul8r.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./reticul8r.css": "./dist/reticul8r.css"
  },
  "sideEffects": ["*.css"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0"
  }
}
